# --- Core ---
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Local:  postgresql://postgres:postgres@localhost:5432/horizon
# Neon:   postgresql://user:pass@ep-xxx.neon.tech/horizon?sslmode=require
# The sync form is accepted; the app rewrites it to the asyncpg driver.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/horizon
DB_ECHO=false

# --- Embeddings ---
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Auth ---
# Server-side pepper mixed into API key hashes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing this invalidates every existing API key.
API_KEY_PEPPER=dev-only-insecure-pepper
